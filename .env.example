APP_ENV=local
SOURCE_SYSTEM=NOVADRIVE

POSTGRES_USER=novadrive_app
POSTGRES_PASSWORD=
POSTGRES_DB=novadrive
POSTGRES_HOST=127.0.0.1
# 15432, no 5432: ver "Hallazgos tecnicos no obvios" en CLAUDE.md - esta
# maquina de desarrollo tiene un Postgres nativo de Windows que ya ocupa
# el 5432. Ajustar si el entorno de despliegue real no tiene ese choque.
POSTGRES_PORT=15432
POSTGRES_SCHEMA=nd

KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRIES=8

# --- Databricks (solo lo usa el bridge) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=novadrive_catalog
# Requerido, sin default en el codigo (hallazgo real 9 sep 2026: un
# default hardcodeado acá apuntaba en silencio al warehouse de Andes) -
# si cambia el workspace, este es el unico lugar que hay que actualizar.
DATABRICKS_WAREHOUSE_ID=
