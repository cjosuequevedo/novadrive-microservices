# .env.production.example - plantilla para el .env real del VPS de
# DigitalOcean (pendiente #3, docker-compose.prod.yml). Copiar a ".env"
# junto a docker-compose.prod.yml EN EL VPS, llenar los valores reales,
# y NUNCA commitear ese archivo (mismo patron que Andes con el suyo:
# ".env" esta en .gitignore, "*.example" es la unica excepcion).
#
# Credenciales de PRODUCCION, nuevas, NUNCA las mismas que en
# desarrollo local (novadrive/.env de esta maquina) - mismo criterio
# que ya aplico Andes en el suyo.

# --- Aplicacion ---
APP_ENV=production
APP_USERNAME=
APP_PASSWORD=
SOURCE_SYSTEM=NOVADRIVE

# --- URL publica (la unica superficie expuesta: Caddy, puerto 80/443) ---
# Sin dominio todavia: usar "http://<IP-del-droplet>". El dia que haya
# un dominio real apuntando aca, cambiar esto a "https://ese-dominio" Y
# cambiar ":80" por ese mismo dominio en Caddyfile (activa HTTPS
# automatico via ACME) - los dos cambios van juntos.
PUBLIC_BASE_URL=

# --- Postgres (contenedor "postgres" del mismo docker-compose.prod.yml) ---
POSTGRES_USER=novadrive_app
POSTGRES_PASSWORD=
POSTGRES_DB=novadrive
# POSTGRES_HOST/POSTGRES_PORT/POSTGRES_SCHEMA quedan fijos en
# docker-compose.prod.yml (postgres:5432, esquema nd) - no hace falta
# declararlos aca.

# --- Databricks (bridge) ---
# Mismo workspace que Andes hoy (ver CLAUDE.md, decision #7 y pendiente
# #4) - mismo HOST/TOKEN/WAREHOUSE_ID que ya estan en el .env de
# desarrollo de esta maquina.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=novadrive_catalog
DATABRICKS_WAREHOUSE_ID=

# --- Outbox / bridge (opcional, defaults razonables si se omiten) ---
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRIES=8
BRIDGE_MAX_CONSECUTIVE_FAILURES=8
BRIDGE_MAX_BUFFER_SIZE=2000
